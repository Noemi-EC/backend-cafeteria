# Copia este archivo como .env y completa los valores.
# El .env NUNCA se sube al repositorio: está en .gitignore.
#
# Acá quedan solo los datos de infraestructura. Las claves de servicios
# externos (OpenRouter, correo) ya no van en este archivo: se cargan desde
# la aplicación, con una cuenta ADMIN, y se guardan cifradas en la base de
# datos. Ver GET /configuracion.

# --- Base de datos ---------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=cafeteria

# --- Sesiones --------------------------------------------------------
# Cadena larga y aleatoria. Si cambia, todas las sesiones se cierran.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Cifrado de la configuración -------------------------------------
# Con esta llave se cifran los valores guardados en la tabla
# configuraciones. Si la pierdes o la cambias, hay que volver a cargar
# las claves desde la app: los valores viejos ya no se podrán descifrar.
# Genera una con: openssl rand -base64 48
CONFIG_SECRET=

# --- Local por defecto -----------------------------------------------
# Local al que se asignan los clientes que se registran desde la app.
LOCAL_ID_DEFAULT=

# --- Correo (solo lo que no es secreto) ------------------------------
# El usuario y la contraseña de aplicación se cargan desde la app.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
MAIL_FROM=Café Link <tu-correo@gmail.com>
