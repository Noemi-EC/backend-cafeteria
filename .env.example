# Copia este archivo como .env y completa los valores.
# El .env NO se sube al repositorio: contiene secretos.

# --- Base de datos ---------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=cafeteria

# --- Sesiones --------------------------------------------------------
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=7d

# Local al que se asignan los clientes que se registran desde la app.
LOCAL_ID_DEFAULT=

# Minutos que deben pasar entre dos visitas del mismo cliente.
# Evita que un código leído varias veces seguidas sume varias visitas.
# 0 lo desactiva.
VISITA_MINUTOS_ESPERA=30

# --- Inteligencia artificial (OpenRouter) ----------------------------
# La clave vive SOLO aquí, en el servidor. Nunca en la app:
# un APK se puede abrir y leer, así que una clave dentro del teléfono
# es una clave pública.
#
# Se obtiene en https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modelo a usar. El sufijo :free indica la variante gratuita.
# Si responde 429 o deja de existir, basta cambiar esta línea y reiniciar:
# ningún archivo de código menciona un modelo concreto.
OPENROUTER_MODEL=cohere/north-mini-code:free

# Apagar la IA sin borrar la clave (para demostrar la degradación
# elegante: la app sigue funcionando con los mensajes de plantilla).
IA_ACTIVA=true
